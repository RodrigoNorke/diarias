    script
     ====== DADOS ======
    const STORAGE_KEY = 'diarias_app_v1';
    let diarias = carregar();

    function carregar() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)  '[]'); }
      catch(e) { return []; }
    }
    function salvar() { localStorage.setItem(STORAGE_KEY, JSON.stringify(diarias)); }
    function moeda(v) { return 'R$ ' + Number(v).toLocaleString('pt-BR', {minimumFractionDigits2,maximumFractionDigits2}); }
    function dataBr(d) { return new Date(d+'T000000').toLocaleDateString('pt-BR', {day'2-digit',month'long',year'numeric'}); }
    function mesAno(d) { return new Date(d+'T000000').toLocaleDateString('pt-BR', {month'long',year'numeric'}); }
    function chaveMes(d) { const dt=new Date(d+'T000000'); return dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0'); }

     ====== MODAL ======
    function abrirModal() {
      document.getElementById('modal').style.display='flex';
      document.getElementById('data').value = new Date().toISOString().split('T')[0];
      document.getElementById('valor').value='';
      document.getElementById('descricao').value='';
      setTimeout(()=document.getElementById('valor').focus(),50);
    }
    function fecharModal() { document.getElementById('modal').style.display='none'; }
    document.getElementById('modal').addEventListener('click', e = { if(e.target.id==='modal') fecharModal(); });
    document.addEventListener('keydown', e = { if(e.key==='Escape') fecharModal(); });

     ====== CRUD ======
    function salvarDiaria(e) {
      e.preventDefault();
      const valor = parseFloat(document.getElementById('valor').value);
      const data = document.getElementById('data').value;
      const descricao = document.getElementById('descricao').value.trim();
      if (!valor  !data) return;
      diarias.push({ id Date.now(), valor, data, descricao });
      diarias.sort((a,b) = b.data.localeCompare(a.data));
      salvar();
      fecharModal();
      atualizarTudo();
    }

    function excluir(id) {
      if (!confirm('Deseja realmente excluir esta diária')) return;
      diarias = diarias.filter(d = d.id !== id);
      salvar();
      atualizarTudo();
    }

     ====== FILTROS ======
    function diariasFiltradas() {
      const ano = document.getElementById('filtroAno').value;
      if (!ano  ano === 'todos') return diarias;
      return diarias.filter(d = d.data.startsWith(ano));
    }
    function limparFiltro() {
      document.getElementById('filtroAno').value = 'todos';
      atualizarTudo();
    }
    function preencherAnos() {
      const sel = document.getElementById('filtroAno');
      const anos = [...new Set(diarias.map(d = d.data.slice(0,4)))].sort((a,b)=b-a);
      sel.innerHTML = 'option value=todosTodos os anosoption' + anos.map(a = `option value=${a}${a}option`).join('');
    }

     ====== MÉTRICAS ======
    function atualizarMetricas() {
      const lista = diariasFiltradas();
      const total = lista.reduce((s,d)=s+d.valor,0);
      const qtd = lista.length;
      const media = qtd0  totalqtd  0;
      const maior = qtd0  lista.reduce((m,d)=d.valorm.valordm)  null;

      const hoje = new Date();
      const chaveHoje = hoje.getFullYear()+'-'+String(hoje.getMonth()+1).padStart(2,'0');
      const mesLista = diarias.filter(d = chaveMes(d.data)===chaveHoje);
      const totalMes = mesLista.reduce((s,d)=s+d.valor,0);

      document.getElementById('total').textContent = moeda(total);
      document.getElementById('subtotalInfo').textContent = `${qtd} diária${qtd===1'''s'} registrada${qtd===1'''s'}`;
      document.getElementById('media').textContent = moeda(media);
      document.getElementById('maior').textContent = maior  moeda(maior.valor)  moeda(0);
      document.getElementById('maiorData').textContent = maior  dataBr(maior.data)  '—';
      document.getElementById('mesAtual').textContent = moeda(totalMes);
      document.getElementById('mesInfo').textContent = `${mesLista.length} diária${mesLista.length===1'''s'} em ${mesAno(hoje.toISOString().split('T')[0])}`;
    }

     ====== TABELA ======
    function atualizarTabela() {
      const lista = diariasFiltradas();
      const tb = document.getElementById('tabelaDiarias');
      const vazio = document.getElementById('vazio');

      if (lista.length === 0) {
        tb.innerHTML = '';
        vazio.style.display = 'block';
        return;
      }
      vazio.style.display = 'none';

      tb.innerHTML = lista.map(d = `
        tr class=tbl-row style=border-bottom1px solid var(--border)
          td class=py-3.5 font-medium style=colorvar(--text)${dataBr(d.data)}td
          td class=py-3.5 style=colorvar(--muted)${d.descricao  'span style=opacity.5Sem descriçãospan'}td
          td class=py-3.5 text-right font-semibold currency style=colorvar(--accent);font-family'Cormorant Garamond',serif;font-size18px${moeda(d.valor)}td
          td class=py-3.5 text-right
            button onclick=excluir(${d.id}) title=Excluir style=colorvar(--muted);padding8px;border-radius8px;transitionall .15s onmouseover=this.style.background='rgba(220,38,38,.15)';this.style.color='#f87171' onmouseout=this.style.background='transparent';this.style.color='var(--muted)'
              svg width=16 height=16 viewBox=0 0 24 24 fill=none stroke=currentColor stroke-width=2polyline points=3 6 5 6 21 6path d=M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6path d=M10 11v6path d=M14 11v6svg
            button
          td
        tr
      `).join('');
    }

     ====== GRÁFICO ======
    let graficoInstancia = null;
    function atualizarGrafico() {
      const lista = diariasFiltradas();
      const el = document.getElementById('grafico');
      if(!el) return;
      if(typeof echarts==='undefined'){setTimeout(atualizarGrafico,250);return;}

      if(!graficoInstancia) graficoInstancia = echarts.init(el);

      const meses = {};
      lista.forEach(d = {
        const k = chaveMes(d.data);
        meses[k] = (meses[k]0) + d.valor;
      });
      const chaves = Object.keys(meses).sort();
      const rotulos = chaves.map(k = {
        const [a,m] = k.split('-');
        return new Date(a,Number(m)-1,1).toLocaleDateString('pt-BR',{month'short',year'2-digit'});
      });
      const valores = chaves.map(k = meses[k]);

      const st = getComputedStyle(document.documentElement);
      const accent = st.getPropertyValue('--accent').trim()  '#c9923c';
      const muted = st.getPropertyValue('--muted').trim()  '#8b9ab8';
      const card = st.getPropertyValue('--card').trim()  '#262a3a';
      const text = st.getPropertyValue('--text').trim()  '#e8ecf4';
      const border = st.getPropertyValue('--border').trim()  'rgba(139,154,184,.16)';

      const grad = {type'linear',x0,y0,x20,y21,colorStops[
        {offset0,coloraccent+'cc'},
        {offset1,coloraccent+'15'}
      ]};

      graficoInstancia.setOption({
        backgroundColor'transparent',
        tooltip{
          trigger'axis',
          backgroundColorcard,
          borderColorborder,
          textStyle{colortext,fontFamily'Source Sans 3'},
          formatter p = `strong${p[0].axisValue}strongbrspan style=color${accent};font-weight700${moeda(p[0].value)}span`,
          axisPointer{type'shadow',shadowStyle{coloraccent+'15'}}
        },
        grid{left'3%',right'4%',bottom'3%',top'10%',containLabeltrue},
        xAxis{
          type'category',
          datarotulos.lengthrotulos['Sem dados'],
          axisLabel{colormuted,fontFamily'Source Sans 3',fontSize11},
          axisTick{showfalse},
          axisLine{lineStyle{colorborder}}
        },
        yAxis{
          type'value',
          scaletrue,
          axisLabel{colormuted,fontFamily'Source Sans 3',fontSize11,formatter v = 'R$ '+v},
          splitLine{lineStyle{colorborder,type'dashed'}}
        },
        series[{
          type'bar',
          datavalores.lengthvalores[0],
          barWidth'55%',
          itemStyle{
            borderRadius[8,8,0,0],
            colorgrad,
            borderColoraccent,
            borderWidth1
          },
          emphasis{itemStyle{coloraccent,borderColoraccent}},
          label{
            showvalores.length0 && valores.length=12,
            position'top',
            colortext,
            fontFamily'Cormorant Garamond',
            fontWeight700,
            fontSize13,
            formatter p = moeda(p.value)
          }
        }]
      }, true);

      window.addEventListener('resize', () = graficoInstancia && graficoInstancia.resize());
    }

     ====== EXPORTAÇÃO ======
    function exportarDados() {
      if (diarias.length===0) { alert('Nada para exportar'); return; }
      const csv = 'Data,Descrição,Valorn' + diarias
        .sort((a,b)=a.data.localeCompare(b.data))
        .map(d = `${d.data},${(d.descricao'').replace(g,'')},${d.valor.toFixed(2).replace('.',',')}`)
        .join('n');
      const blob = new Blob(['ufeff'+csv], {type'textcsv;charset=utf-8'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `diarias_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
    }

     ====== INICIALIZAÇÃO ======
    function atualizarTudo() {
      preencherAnos();
      atualizarMetricas();
      atualizarTabela();
      atualizarGrafico();
    }
    atualizarTudo();
    script
